{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@app/*": ["./src/renderer/src/app/*"],
      "@ui/*": ["./src/renderer/src/ui/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src/renderer",
    "src/shared",
    ".storybook/preview.tsx",
    ".storybook/manager.ts",
    ".storybook/theme.ts",
    "test/factories/makeAchievement.ts",
    "test/factories/makeGameView.ts",
    "test/factories/makeGameSummary.ts"
  ]
}
