{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@app/*": ["./src/renderer/src/app/*"],
      "@ui/*": ["./src/renderer/src/ui/*"],
      "@shared/*": ["./src/shared/*"],
      "@tests/*": ["./__tests__/*"]
    }
  },
  "include": [
    "src/renderer",
    "src/shared",
    ".storybook/preview.tsx",
    ".storybook/manager.ts",
    ".storybook/theme.ts",
    "__tests__/factories/makeAchievement.ts",
    "__tests__/factories/makeGameView.ts",
    "__tests__/factories/makeGameSummary.ts"
  ],
  // Specs use Node (fixtures, helpers), which this project does not have:
  // those of `shared/` are checked by `tsconfig.node.json`, those of the
  // interface by `tsconfig.webtest.json`.
  "exclude": ["src/**/*.spec.ts"]
}
