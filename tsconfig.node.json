{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@app/*": ["./src/renderer/src/app/*"],
      "@ui/*": ["./src/renderer/src/ui/*"],
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "test",
    "*.config.ts",
    ".storybook/main.ts",
    "*.config.mjs"
  ],
  "exclude": ["test/renderer/app/store"]
}
