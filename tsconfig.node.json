{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@app/*": ["./src/renderer/src/app/*"],
      "@ui/*": ["./src/renderer/src/ui/*"],
      "@shared/*": ["./src/shared/*"],
      "@tests/*": ["./__tests__/*"]
    }
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "__tests__",
    "*.config.ts",
    ".storybook/main.ts",
    "*.config.mjs"
  ],
  "exclude": ["__tests__/makeAppStore.ts"]
}
